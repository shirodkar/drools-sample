package rules;

import com.example.drools.model.Order;
import com.example.drools.model.OrderResult;
import com.example.drools.model.CustomerType;

rule "VIP Free Shipping"
    salience 3
    when
        $order : Order(customerType == CustomerType.VIP)
        $result : OrderResult()
    then
        $result.setFreeShipping(true);
        $result.addMessage("VIP members always get free shipping");
end

rule "Premium Free Shipping Over 50"
    salience 3
    when
        $order : Order(customerType == CustomerType.PREMIUM, totalAmount >= 50)
        $result : OrderResult()
    then
        $result.setFreeShipping(true);
        $result.addMessage("Premium free shipping on orders >= $50");
end

rule "Standard Free Shipping Over 100"
    salience 3
    when
        $order : Order(totalAmount >= 100)
        $result : OrderResult()
    then
        $result.setFreeShipping(true);
        $result.addMessage("Free shipping on orders >= $100");
end
